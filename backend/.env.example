# Backend config
APP_HOST=127.0.0.1
APP_PORT=8000

# Comma-separated origins for CORS (frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Providers: mock (default) or future: azure/openai/local
STT_PROVIDER=mock
MT_PROVIDER=mock
TTS_PROVIDER=mock

# Local STT (Whisper) - used when STT_PROVIDER=local_whisper
STT_MODEL_DIR=models/asr_whisper_ewe
WHISPER_LANGUAGE=ewe
WHISPER_TASK=transcribe

# Local MT model directories (Hugging Face checkpoints)
# Used when MT_PROVIDER=local_transformers
MT_MODEL_DIR_EE_TO_FR=models/mt_ee_to_fr
MT_MODEL_DIR_FR_TO_EE=models/mt_fr_to_ee

# Where generated audio files are stored
AUDIO_STORAGE_DIR=storage/audio

# Optional: max upload size safeguards (bytes)
MAX_UPLOAD_BYTES=52428800
